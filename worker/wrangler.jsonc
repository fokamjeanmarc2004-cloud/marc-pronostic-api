{
  // Bot Telegram Cousin Marc sur Cloudflare Workers
  "name": "cousinmarc-bot",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  // 5h00 et 20h00 UTC = 6h00 et 21h00 au Cameroun (messages promo du canal)
  "triggers": { "crons": ["0 5 * * *", "0 20 * * *"] },
  "observability": { "enabled": true }
}
