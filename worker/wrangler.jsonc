{
  // Bot Telegram Cousin Marc sur Cloudflare Workers
  "name": "cousinmarc-bot",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  // 5h00, 20h00 et 23h00 UTC = 6h00, 21h00 et minuit au Cameroun (promo + pronostics du canal)
  "triggers": { "crons": ["0 5 * * *", "0 20 * * *", "0 23 * * *"] },
  "observability": { "enabled": true }
}
