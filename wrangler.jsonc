{
  // Bot Telegram Cousin Marc sur Cloudflare Workers (le code est dans le dossier worker/)
  "name": "cousinmarc-bot",
  "main": "worker/src/index.js",
  "compatibility_date": "2025-09-01",
  // Un seul horaire (limite de 5 sur le compte gratuit) : 5h, 12h et 20h UTC = 6h, 13h (rappel VIP) et 21h au Cameroun
  "triggers": { "crons": ["0 5,12,20 * * *"] },
  "observability": { "enabled": true }
}
